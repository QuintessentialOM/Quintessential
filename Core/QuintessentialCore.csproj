<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace />
    <AssemblyName>QuintessentialCore</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	  <!-- TODO: Add documentation -->
  </PropertyGroup>

	<PropertyGroup>
		<!-- Path to Opus Magnum folder, Contains Lightning.exe et.al -->
		<OpusDir>D:\C#_projects\Quintessential\TestEnvironment\modded</OpusDir>
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>
	
  <ItemGroup>
    <None Remove="Content\missing.png" />
  </ItemGroup>

  <ItemGroup>
      <PackageReference Include="YamlDotNet" Version="11.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="DevLightning">
      <HintPath>$(OpusDir)\DevLightning_Core.dll</HintPath>
      <Private>false</Private>
      <CopyLocal>False</CopyLocal>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>$(OpusDir)\Mono.Cecil.dll</HintPath>
      <CopyLocal>False</CopyLocal>
    </Reference>
    <Reference Include="MonoMod">
      <HintPath>$(OpusDir)\MonoMod.Patcher.dll</HintPath>
      <CopyLocal>False</CopyLocal>
    </Reference>
    <Reference Include="MonoMod.Utils">
      <HintPath>$(OpusDir)\MonoMod.Utils.dll</HintPath>
      <CopyLocal>False</CopyLocal>
    </Reference>
  </ItemGroup>

</Project>
